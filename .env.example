# Jawa Quant Computer environment configuration.
# Copy to `.env` and adjust. All values are optional; demo mode works with none.
# Settings can also be passed as env vars with the JQC_ prefix.

# --- Storage ----------------------------------------------------------------
# JQC_DATA_DIR: directory for the SQLite DB, secret vault key and logs
#JQC_DATA_DIR=./jqc-data

# Root the agent may freely read/write (everything else is denied)
#JQC_WORKSPACE_DIR=./jqc-workspace

# --- Runtime ----------------------------------------------------------------
# Demo mode: fall back to the deterministic mock provider when no provider is set
#JQC_DEMO_MODE=true

# Human approval mode: prompt (default) or auto
#JQC_APPROVAL_MODE=prompt

# "Computer" budgets per task
#JQC_MAX_RUNTIME_SECONDS=600
#JQC_MAX_STEPS_PER_TASK=20

# --- Browser ----------------------------------------------------------------
# Driver selection: "mock", "playwright", or unset for auto-detect
#JQC_BROWSER_DRIVER=mock

# Run Chromium headless (set false to watch it work)
#JQC_BROWSER_HEADLESS=true

# Where Playwright browsers live (must match `python -m playwright install`)
#PLAYWRIGHT_BROWSERS_PATH=/home/you/.cache/ms-playwright

# --- Server -----------------------------------------------------------------
#JQC_HOST=127.0.0.1
#JQC_PORT=8765

# --- Model providers --------------------------------------------------------
# Pre-register an OpenAI-compatible provider at startup:
#JQC_PROVIDER_BASE_URL=https://api.openai.com/v1
#JQC_PROVIDER_MODEL=gpt-4o-mini
#JQC_PROVIDER_API_KEY=sk-...   (stored encrypted in the OS keyring)

# Use local Ollama instead:
#JQC_OLLAMA_BASE_URL=http://127.0.0.1:11434
#JQC_OLLAMA_MODEL=qwen2.5:7b